# WorkTrack self-hosted Linux VM environment template
# Copy to deploy/.env and fill with unique per-environment secrets.
# NEVER commit deploy/.env to source control.
# NEVER put SUPABASE_SERVICE_ROLE_KEY in any VITE_* variable.

# Public browser build-time config (points to your self-hosted Supabase API subdomain)
VITE_SUPABASE_URL=https://api.worktrack.example.co.za
VITE_SUPABASE_ANON_KEY=replace-with-self-hosted-anon-key

# Server-side only (used by migrate.sh / backup.sh — never exposed to browser)
DATABASE_URL=postgresql://postgres:replace-with-strong-password@127.0.0.1:5432/postgres
BACKUP_DIR=/var/backups/worktrack
BACKUP_GPG_RECIPIENT=backups@example.co.za

# Container binding (keep localhost-only behind your existing reverse proxy)
WORKTRACK_BIND_HOST=127.0.0.1
WORKTRACK_BIND_PORT=3080